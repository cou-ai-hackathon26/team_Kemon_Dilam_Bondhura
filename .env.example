# Local development. Set a fresh key before starting the API.
SAFELEDGER_DB=./capzoryx.sqlite3
SAFELEDGER_SIGNING_KEY=
SAFELEDGER_PUBLIC_URL=http://127.0.0.1:5173
SAFELEDGER_CORS_ORIGINS=http://127.0.0.1:5173
# Hosted deployments require both values from a newly created database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# The local parser, forecasts and loan calculator run without provider keys.
SAFELEDGER_LLM_FREE_TIER_CONFIRMED=0
SAFELEDGER_ALLOW_PAID_AI=0

# Emergency read-only mode. Restart the API after changing this value.
SAFELEDGER_READ_ONLY=0
# Daily reservation per workspace for optional external inference.
SAFELEDGER_AI_DAILY_TOKENS=250000
# Keep disabled unless the translation project is verified to prevent charges.
SAFELEDGER_GOOGLE_TRANSLATE_FREE_CONFIRMED=0
# Optional local model. Set the exact loopback URL and only tasks qualified by evaluation.
SAFELEDGER_LOCAL_LLM_URL=
SAFELEDGER_LOCAL_LLM_MODEL=hisab-lm
SAFELEDGER_LOCAL_LLM_TASKS=

# Optional signing-key ring. The existing stable SAFELEDGER_SIGNING_KEY remains required.
SAFELEDGER_SIGNING_KEYS=
SAFELEDGER_ACTIVE_SIGNING_KEY_ID=

# Chat channels. Telegram and the in-app chat share one conversation brain (api/app/chat/).
# Natural chat: own Hisab-Chat model first, then free API tiers (any subset). SAFELEDGER_CHAT_LLM=0 turns it off.
SAFELEDGER_CHAT_LLM=1
CAPZORYX_CHAT_MAX_TOKENS=300
CAPZORYX_CHAT_HISAB_URL=
CAPZORYX_CHAT_HISAB_KEY=
CAPZORYX_CHAT_GROQ_KEY=
# Optional: when empty, the existing SAFELEDGER_LLM_API_KEY Gemini key is reused for chat.
CAPZORYX_CHAT_GEMINI_KEY=
CAPZORYX_CHAT_CEREBRAS_KEY=
CAPZORYX_CHAT_OPENROUTER_KEY=
CAPZORYX_CHAT_MISTRAL_KEY=
CAPZORYX_CHAT_GITHUB_KEY=
